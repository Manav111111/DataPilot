# ==========================================
# DataNexa Environment Configuration
# ==========================================

# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=True

# Backend Configuration
PROJECT_NAME="DataNexa - AI-Powered Data Intelligence Platform"
API_V1_STR=/api/v1
SECRET_KEY=supersecretkey_change_in_production_at_least_32_characters_long_123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=data_intelligence_db
# Async connection string for SQLAlchemy
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/data_intelligence_db

# ==========================================
# Phase 2 & 3: AI & Search API Providers
# ==========================================
# Supported AI Providers: gemini, groq, mock (deterministic test provider)
AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# Tavily Search API
TAVILY_API_KEY=your_tavily_api_key_here

# Firecrawl Web Scraping & Content Extraction API
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# ==========================================
# Background Jobs: Redis & Celery
# ==========================================
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ==========================================
# Phase 2: Planning Limits
# ==========================================
MAX_PLAN_SEARCH_QUERIES=10
MAX_PLAN_FIELDS=25

# ==========================================
# Phase 3: Collection Engine Limits & Controls
# ==========================================
COLLECTION_MAX_QUERIES=15
COLLECTION_MAX_RESULTS_PER_QUERY=10
COLLECTION_MAX_SOURCES_PER_JOB=100
COLLECTION_MAX_RECORDS_PER_JOB=1000
COLLECTION_MAX_RETRIES=3
COLLECTION_CONCURRENCY=3
COLLECTION_REQUEST_TIMEOUT_SECONDS=60
COLLECTION_MAX_CONTENT_LENGTH=50000

# ==========================================
# Phase 4: Data Quality, Analytics, Export & Management
# ==========================================
DATASET_MAX_RECORDS_FOR_SYNC=5000
DATASET_PROFILE_BATCH_SIZE=1000
DATASET_EXPORT_MAX_RECORDS=100000
DATASET_EXPORT_MAX_FILE_SIZE_MB=100
DATASET_VERSIONING_ENABLED=true
EXPORT_STORAGE_DIR=./storage/exports
EXPORT_FILE_RETENTION_HOURS=24

# ==========================================
# Frontend Configuration
# ==========================================
VITE_API_BASE_URL=http://localhost:8000
FRONTEND_PORT=5173
BACKEND_PORT=8000

# CORS Configuration (comma-separated origins)
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
